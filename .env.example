# ==============================================================================
# BUSINESS MANAGER — MAGIC QUANT TRADING Corp
# Production & Local Environment Configuration Template
# ==============================================================================

# Application
NEXT_PUBLIC_APP_NAME="Business Manager"
NEXT_PUBLIC_COMPANY_NAME="MAGIC QUANT TRADING Corp"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Multi-Tenant & Database (Supabase / PostgreSQL)
# When SUPABASE_URL is provided, full remote PostgreSQL + RLS is used.
# When running offline/dev/demo, built-in in-memory fallback database engine runs.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Platform Owner Security
ADMIN_SECRET_KEY="mqt-admin-supersecret-token-change-in-prod"
JWT_SECRET="mqt-business-manager-secure-jwt-secret-key-32chars"

# South African Payment Gateways
# Yoco (Default South African Card Gateway)
NEXT_PUBLIC_YOCO_PUBLIC_KEY="pk_test_sample_yoco_key"
YOCO_SECRET_KEY="sk_test_sample_yoco_key"
YOCO_WEBHOOK_SECRET="whsec_sample_yoco_secret"

# Paystack (Alternative African Gateway)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_sample_paystack_key"
PAYSTACK_SECRET_KEY="sk_test_sample_paystack_key"

# AI Infrastructure (Provider-Agnostic LLM Engine)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
DEFAULT_AI_MODEL="gpt-4o"
MAX_AGENT_EXECUTION_TIMEOUT_MS="120000"
MAX_AGENT_TOKENS_PER_RUN="8000"

# Notifications & Transactional Email
EMAIL_PROVIDER="console" # Options: console, resend, sendgrid, smtp
RESEND_API_KEY=""
EMAIL_FROM="Business Manager <notifications@magicquant.co.za>"
SUPPORT_EMAIL="support@magicquant.co.za"

# Integrations Configuration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
WHATSAPP_BUSINESS_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
